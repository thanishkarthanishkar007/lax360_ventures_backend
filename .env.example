# Copy this file to .env for local development (never commit the real .env).
# On Render, set these as Environment Variables in the service dashboard instead.

PORT=8080

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?appName=<app-name>

RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=LAX360 Ventures <onboarding@resend.dev>
NOTIFY_EMAIL=lax360salem@gmail.com

CORS_ALLOWED_ORIGINS=https://lax360-ventures-frontend.vercel.app,http://localhost:5173,http://localhost:3000

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MS=86400000

LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
